    <property name="styleSheet">
     <string notr="true">#info_frame QLabel,
#info_frame QLineEdit,
#info_frame QComboBox,
#function_frame QPushButton,
QHeaderView::section {
    font-family: 'Segoe UI Semibold';
    font-size: 12px;
}

/* Styles for input fields and combo boxes inside info_frame */
#info_frame QLineEdit,
#info_frame QComboBox {
    padding: 4px 5px;
    border: 1px solid #838383;
    border-radius: 2px;
}

/* Focus styles for input fields and combo boxes */
#info_frame QLineEdit:focus,
#info_frame QComboBox:focus {
    border-color: #0055ff;
}


QComboBox::drop-down{
background:transparent;
border:none;
margin-right:5px;
}


#result_frame{
border-radius:5px;
background-color:#fff;
}

QTableWidget{
border-radius:3px;
border: 1px solid #f0f0f0;
}


QHeaderView::section{
border:none;
border-bottom: 1px solid #d0c6ff;
text-align:left;
padding: 3px 5px;

}

QTableWidget::item{
border-bottom:1px solid #d0c6ff;
color:#000;
padding-left:3px;
}


#function_frame QPushButton {
    font-size: 14px;
    padding: 5px 10px;
    border: 2px solid #f0f0f0;
    border-radius: 5px;
    background-color: #84a8f7;
}


/*#function_frame#delete_btn{
background-color:#ff8183;
}*/

#function_frame QPushButton:hover{
border-color:#4c96f7;
font-size:15px;
}

#function_frame#delete_btn:hover {
border-color:#dc004;
}



#delete_btn {
    background-color: #ff0000; /* Default background color */
    color: white; /* Text color */
    border-radius: 5px; /* Rounded corners */
    padding: 5px 10px; /* Padding for the button */
}

#delete_btn:hover {
    background-color: #dc0003; /* Change background on hover */
}



</string>
